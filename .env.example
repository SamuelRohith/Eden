# EDEN: copy this file to .env. Restart npm start after changing settings.
# Credentials stay on the server. Never put .env or API keys inside dist/.
# No cloud calls occur while this is false.
EDEN_ALLOW_CLOUD=false

# auto = Microsoft when cloud is enabled AND its credentials exist; otherwise local.
# Alternatives: ollama | azure_openai, chroma | local | azure_search, browser | azure_speech.
EDEN_AI_PROVIDER=auto
EDEN_RETRIEVAL_PROVIDER=auto
EDEN_SPEECH_PROVIDER=auto
# Backups are for testing purposes and smooth execution. Provider is shown in the UI.
EDEN_ENABLE_FALLBACK=true

# Microsoft Agent Framework runs the local storyteller with Qwen.
# direct skips Python and calls the same local model directly.
EDEN_AGENT_RUNTIME=framework
# Blank uses .venv/Scripts/python.exe (Windows) or .venv/bin/python (other OS).
EDEN_PYTHON_PATH=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
EDEN_AI_CONTEXT_TOKENS=4096
EDEN_AI_MAX_OUTPUT_TOKENS=650
EDEN_AI_TIMEOUT_MS=60000
EDEN_CLOUD_TIMEOUT_MS=12000
PORT=4173

# OPTIONAL MICROSOFT MODEL: fill these three, then enable EDEN_ALLOW_CLOUD.
# Use a deployed chat-completions-compatible model with JSON output support.
# Resource endpoint: https://YOUR-RESOURCE.openai.azure.com
# Or: https://YOUR-RESOURCE.services.ai.azure.com
# Do not use a Foundry /api/projects/... URL here.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# OPTIONAL AZURE AI SEARCH: use an existing Free-tier service if available.
# Endpoint: https://YOUR-SEARCH.search.windows.net
# Admin key needed to create the index and upload events. It stays server-side.
# Once configured, run npm run azure:setup-search to create this index.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=eden-events
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_API_VERSION=2024-07-01

# OPTIONAL AZURE SPEECH: resource region (e.g. eastus) and key. Select F0 in Azure.
# Leave voice blank for language-specific English, Arabic and Spanish defaults.
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
AZURE_SPEECH_VOICE=

# OPTIONAL AZURE FUNCTIONS: https://APP.azurewebsites.net/api/eden
# Local Node server proxies requests; its function key never enters the browser.
# Azure functions use Application settings for their model/search/speech keys.
EDEN_FUNCTIONS_URL=
AZURE_FUNCTIONS_KEY=

# OPTIONAL APPLICATION INSIGHTS: connection string from your resource.
# Blank means local operational metrics only at /api/metrics.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Local semantic match memory. CPU BGE model; persistent cosine-search Chroma.
# Run npm run setup:rag once. No API key or separate database server is needed.
EDEN_SEMANTIC_ENABLED=true
EDEN_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EDEN_EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EDEN_CHROMA_PATH=.data/chroma
EDEN_EMBEDDING_CACHE=.data/models
EDEN_EMBEDDING_THREADS=2
EDEN_EMBEDDING_TIMEOUT_MS=120000
EDEN_RETRIEVAL_TOP_K=6
EDEN_RETRIEVAL_RETAIN_MATCHES=20
